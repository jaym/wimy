// wimy configuration — wmii-style window manager for river.
//
// Copy to ~/.config/wimy/config.kdl and edit. All settings are
// optional; the defaults (shown here) apply when the file is absent.
//
// Note: inside single-line blocks, end the command with a semicolon,
// e.g. bind "Mod-h" { focus "left"; }

// Primary modifier: Mod1 (Alt), Mod3, Mod4 (Super) or Mod5.
// wmii used Mod1; the default is Mod4.
mod "Mod4"

// Programs. `launcher` is the program launcher (Mod-p). `menu` is
// used for tag/action prompts; it must read choices on stdin and
// print the selection on stdout, dmenu-style.
terminal "alacritty"
launcher "fuzzel"
menu "fuzzel --dmenu"

// Focus borders drawn by the compositor.
border width=2 focused="#8aadf4" normal="#363a4f"

// Height in pixels of unfocused window strips in stack mode.
stack-strip 28

// --- key bindings ---------------------------------------------------
// Mod refers to the primary modifier; Shift, Ctrl, Alt and Super are
// also recognized. Keys are single characters (the PHYSICAL key — use
// "Mod-Shift-c", not "Mod-Shift-C") or names: Return, space, Tab,
// Escape, BackSpace, Delete, Home, End, Page_Up, Page_Down,
// Left, Up, Right, Down, F1..F12.
// Note: bindings match modifiers exactly; they do not fire while
// NumLock or CapsLock is active.
//
// The defaults below apply automatically as long as your config file
// declares NO bind of its own. Once you declare any bind, all defaults
// are replaced — re-declare the ones you want to keep.

bind "Mod-Return" { spawn-terminal; }
bind "Mod-p" { spawn-menu; }
bind "Mod-a" { action; }
bind "Mod-Shift-c" { kill; }

// moving around
bind "Mod-h" { focus "left"; }
bind "Mod-l" { focus "right"; }
bind "Mod-j" { focus "down"; }
bind "Mod-k" { focus "up"; }
bind "Mod-space" { focus-toggle-layer; }
bind "Mod-t" { view; }       // asks for a tag via the menu
bind "Mod-n" { view-next; }
bind "Mod-b" { view-prev; }

// moving things around
bind "Mod-Shift-h" { move "left"; }
bind "Mod-Shift-l" { move "right"; }
bind "Mod-Shift-j" { move "down"; }
bind "Mod-Shift-k" { move "up"; }
bind "Mod-Shift-space" { toggle-float; }
bind "Mod-Shift-t" { moveto; }  // asks for a tag via the menu

// column modes
bind "Mod-d" { mode "default"; }
bind "Mod-s" { mode "stack"; }
bind "Mod-m" { mode "max"; }

// numbered views (0 means 10)
bind "Mod-1" { view-n 1; }
bind "Mod-2" { view-n 2; }
bind "Mod-3" { view-n 3; }
bind "Mod-4" { view-n 4; }
bind "Mod-5" { view-n 5; }
bind "Mod-6" { view-n 6; }
bind "Mod-7" { view-n 7; }
bind "Mod-8" { view-n 8; }
bind "Mod-9" { view-n 9; }
bind "Mod-0" { view-n 0; }
bind "Mod-Shift-1" { moveto-n 1; }
bind "Mod-Shift-2" { moveto-n 2; }
bind "Mod-Shift-3" { moveto-n 3; }
bind "Mod-Shift-4" { moveto-n 4; }
bind "Mod-Shift-5" { moveto-n 5; }
bind "Mod-Shift-6" { moveto-n 6; }
bind "Mod-Shift-7" { moveto-n 7; }
bind "Mod-Shift-8" { moveto-n 8; }
bind "Mod-Shift-9" { moveto-n 9; }
bind "Mod-Shift-0" { moveto-n 0; }

// --- actions ----------------------------------------------------------
// Named shell commands run with Mod-a. Add your own here.
action "quit" { run "wimyctl quit"; }

// --- autostart --------------------------------------------------------
// Programs started with the window manager. Examples:
//   waybar with the wimy modules from contrib/waybar/
//   kanshi for display resolution/scale (see contrib/kanshi/config)
// autostart {
// 	exec "kanshi"
// 	exec "waybar -c ~/.config/waybar/config.jsonc -s ~/.config/waybar/style.css"
// }
