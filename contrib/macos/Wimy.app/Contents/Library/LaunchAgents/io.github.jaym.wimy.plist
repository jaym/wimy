<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Login agent, registered by wimy itself through SMAppService when
     start-at-login is on. KeepAlive restarts wimy after a crash but not
     after `wimyctl quit` (a successful exit). -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>io.github.jaym.wimy</string>
	<key>BundleProgram</key>
	<string>Contents/MacOS/wimy</string>
	<key>AssociatedBundleIdentifiers</key>
	<array>
		<string>io.github.jaym.wimy</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>ProcessType</key>
	<string>Interactive</string>
</dict>
</plist>
