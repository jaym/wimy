<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The SMAppService login agent older wimys registered. A self-signed
     build fails its launch constraints at login, so wimy now writes a
     plain ~/Library/LaunchAgents agent instead (internal/macos/login.go)
     and only keeps this file so it can unregister the old item. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>io.github.jaym.wimy</string>
	<key>BundleProgram</key>
	<string>Contents/MacOS/wimy</string>
	<key>AssociatedBundleIdentifiers</key>
	<array>
		<string>io.github.jaym.wimy</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>ProcessType</key>
	<string>Interactive</string>
</dict>
</plist>
